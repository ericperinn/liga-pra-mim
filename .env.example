# Copie para .env e preencha com os valores da sua conta AWS.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
CONNECT_INSTANCE_ARN=arn:aws:connect:us-east-1:123456789012:instance/00000000-0000-0000-0000-000000000000
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AMPLIFY_APP_ID=xxxxxxxxxxxxxx
SITE_URL=https://main.xxxxxxxxxxxxxx.amplifyapp.com
# bedrock (padrão) ou anthropic (chave no SSM em /liga-pra-mim/anthropic-api-key)
LLM_PROVIDER=bedrock
WARMUP_ENABLED=true
